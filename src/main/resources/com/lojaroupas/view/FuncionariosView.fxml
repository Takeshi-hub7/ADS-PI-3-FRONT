<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
    Tela de funcionários (somente administrador): lista com busca e
    filtro de situação (esquerda) e formulário (direita).
    Controller: FuncionariosController. No cadastro novo, o formulário
    pede também o login (e-mail e senha), porque a API exige um usuário
    vinculado a cada funcionário.
-->
<VBox xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.lojaroupas.controller.FuncionariosController"
      spacing="16" styleClass="tela">

    <Label text="Funcionários" styleClass="titulo"/>
    <Label text="Equipe da loja, com ativação e desativação sem apagar o cadastro"
           styleClass="subtitulo"/>

    <HBox spacing="20" VBox.vgrow="ALWAYS">

        <!-- Lista -->
        <VBox styleClass="cartao" spacing="10" HBox.hgrow="ALWAYS">
            <HBox spacing="8">
                <TextField fx:id="campoBusca" HBox.hgrow="ALWAYS"
                           promptText="Buscar por nome ou CPF..."/>
                <ComboBox fx:id="campoFiltroSituacao" prefWidth="140"/>
                <Button text="Atualizar" onAction="#carregar"
                        styleClass="botao-secundario"/>
            </HBox>
            <TableView fx:id="tabelaFuncionarios" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colunaNome" text="Nome" prefWidth="200"/>
                    <TableColumn fx:id="colunaCpf" text="CPF" prefWidth="130"/>
                    <TableColumn fx:id="colunaTelefone" text="Telefone" prefWidth="135"/>
                    <TableColumn fx:id="colunaSituacao" text="Situação" prefWidth="90"/>
                </columns>
            </TableView>
            <Label fx:id="rotuloTotal" styleClass="dica"/>
        </VBox>

        <!-- Formulário -->
        <VBox styleClass="cartao" prefWidth="360" minWidth="360">
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        styleClass="rolagem-formulario">
                <VBox spacing="8">
                    <Label fx:id="rotuloTituloFormulario" text="Novo funcionário"
                           styleClass="secao"/>

                    <Label text="Nome completo *" styleClass="rotulo"/>
                    <TextField fx:id="campoNome"/>

                    <HBox spacing="10">
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="CPF *" styleClass="rotulo"/>
                            <TextField fx:id="campoCpf" promptText="000.000.000-00"/>
                        </VBox>
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="Telefone" styleClass="rotulo"/>
                            <TextField fx:id="campoTelefone" promptText="(00) 00000-0000"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="10">
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="RG" styleClass="rotulo"/>
                            <TextField fx:id="campoRg"/>
                        </VBox>
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="CTPS" styleClass="rotulo"/>
                            <TextField fx:id="campoCtps"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="10">
                        <VBox spacing="8" prefWidth="150" HBox.hgrow="ALWAYS">
                            <Label text="Sexo" styleClass="rotulo"/>
                            <ComboBox fx:id="campoSexo" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="8" prefWidth="150" HBox.hgrow="ALWAYS">
                            <Label text="Estado civil" styleClass="rotulo"/>
                            <ComboBox fx:id="campoEstadoCivil" maxWidth="Infinity"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="10">
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="Nascimento" styleClass="rotulo"/>
                            <DatePicker fx:id="campoNascimento" maxWidth="Infinity"
                                        promptText="dd/mm/aaaa"/>
                        </VBox>
                        <VBox spacing="8" prefWidth="115" minWidth="115">
                            <Label text="Dependentes" styleClass="rotulo"/>
                            <TextField fx:id="campoDependentes" promptText="0"/>
                        </VBox>
                    </HBox>

                    <Label text="Salário (R$)" styleClass="rotulo"/>
                    <TextField fx:id="campoSalario" promptText="0,00"/>

                    <VBox fx:id="blocoLogin" spacing="8">
                        <Label text="Acesso ao sistema" styleClass="secao"/>
                        <Label text="E-mail de login *" styleClass="rotulo"/>
                        <TextField fx:id="campoEmail" promptText="nome@trajeloc.com"/>
                        <Label text="Senha inicial * (mínimo 6 caracteres)" styleClass="rotulo"/>
                        <PasswordField fx:id="campoSenha"/>
                    </VBox>

                    <Label fx:id="rotuloSituacao" styleClass="dica"/>
                    <Label fx:id="rotuloErro" styleClass="erro" wrapText="true"/>

                    <HBox spacing="8">
                        <Button fx:id="botaoSalvar" text="Salvar"
                                onAction="#salvar" styleClass="botao-primario"/>
                        <Button text="Limpar" onAction="#novo"
                                styleClass="botao-secundario"/>
                        <Button fx:id="botaoAtivacao" text="Desativar"
                                onAction="#alternarAtivacao" styleClass="botao-perigo"/>
                    </HBox>
                    <Label text="* campos obrigatórios" styleClass="dica"/>
                </VBox>
            </ScrollPane>
        </VBox>
    </HBox>
</VBox>
