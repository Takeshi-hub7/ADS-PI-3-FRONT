<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
    Tela inicial: resumo do dia com indicadores e próximos eventos.
    Controller: InicioController. Os números vêm da API (clientes,
    peças e locações), calculados a partir da data de hoje.
-->
<VBox xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.lojaroupas.controller.InicioController"
      spacing="16" styleClass="tela">

    <HBox alignment="CENTER_LEFT">
        <VBox spacing="4">
            <Label fx:id="rotuloBoasVindas" styleClass="titulo"/>
            <Label fx:id="rotuloData" styleClass="subtitulo"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Atualizar" onAction="#carregar"
                styleClass="botao-secundario"/>
    </HBox>

    <!-- Indicadores -->
    <HBox spacing="16">
        <VBox styleClass="cartao, indicador" HBox.hgrow="ALWAYS">
            <Label fx:id="rotuloEventosSemana" text="–" styleClass="indicador-numero"/>
            <Label text="Eventos nos próximos 7 dias" styleClass="indicador-rotulo"/>
        </VBox>
        <VBox styleClass="cartao, indicador" HBox.hgrow="ALWAYS">
            <Label fx:id="rotuloDevolucoesSemana" text="–" styleClass="indicador-numero"/>
            <Label text="Devoluções nos próximos 7 dias" styleClass="indicador-rotulo"/>
        </VBox>
        <VBox styleClass="cartao, indicador" HBox.hgrow="ALWAYS">
            <Label fx:id="rotuloPecas" text="–" styleClass="indicador-numero"/>
            <Label fx:id="rotuloPecasDetalhe" text="Peças no acervo" styleClass="indicador-rotulo"/>
        </VBox>
        <VBox styleClass="cartao, indicador" HBox.hgrow="ALWAYS">
            <Label fx:id="rotuloClientes" text="–" styleClass="indicador-numero"/>
            <Label text="Clientes cadastrados" styleClass="indicador-rotulo"/>
        </VBox>
    </HBox>

    <!-- Próximos eventos -->
    <VBox styleClass="cartao" spacing="10" VBox.vgrow="ALWAYS">
        <Label text="Próximos eventos" styleClass="secao"/>
        <Label text="Reservas com evento a partir de hoje, em ordem de data"
               styleClass="dica"/>
        <TableView fx:id="tabelaEventos" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colunaQuando" text="Quando" prefWidth="110"/>
                <TableColumn fx:id="colunaEvento" text="Evento" prefWidth="105"/>
                <TableColumn fx:id="colunaCliente" text="Cliente" prefWidth="200"/>
                <TableColumn fx:id="colunaPecas" text="Peças" prefWidth="320"/>
                <TableColumn fx:id="colunaDevolucao" text="Devolução" prefWidth="105"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
