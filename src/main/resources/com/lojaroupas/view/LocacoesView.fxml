<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
    Tela de locações: lista das reservas (esquerda) e formulário de nova
    locação (direita). Controller: LocacoesController.
    A API recusa a reserva se alguma peça já estiver locada em período
    que se sobrepõe ao informado; a mensagem aparece em rotuloErro.
-->
<VBox xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.lojaroupas.controller.LocacoesController"
      spacing="16" styleClass="tela">

    <Label text="Locações" styleClass="titulo"/>
    <Label text="Reserva de peças por período, com bloqueio de datas já ocupadas"
           styleClass="subtitulo"/>

    <HBox spacing="20" VBox.vgrow="ALWAYS">

        <!-- Lista de locações -->
        <VBox styleClass="cartao" spacing="10" HBox.hgrow="ALWAYS">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Reservas registradas" styleClass="secao"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Atualizar" onAction="#carregar"
                        styleClass="botao-secundario"/>
            </HBox>
            <TableView fx:id="tabelaLocacoes" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colunaCliente" text="Cliente" prefWidth="170"/>
                    <TableColumn fx:id="colunaPecas" text="Peças" prefWidth="110"/>
                    <TableColumn fx:id="colunaEvento" text="Evento" prefWidth="105"/>
                    <TableColumn fx:id="colunaDevolucao" text="Devolução" prefWidth="105"/>
                    <TableColumn fx:id="colunaAtendente" text="Atendente" prefWidth="150"/>
                </columns>
            </TableView>
            <Button fx:id="botaoCancelar" text="Cancelar reserva selecionada"
                    onAction="#cancelar" styleClass="botao-perigo"/>
        </VBox>

        <!-- Formulário de nova locação -->
        <VBox styleClass="cartao" spacing="8"
              prefWidth="380" minWidth="380">
            <Label text="Nova locação" styleClass="secao"/>

            <Label text="Cliente *" styleClass="rotulo"/>
            <ComboBox fx:id="campoCliente" maxWidth="Infinity"
                      promptText="Escolha o cliente"/>

            <Label text="Atendente *" styleClass="rotulo"/>
            <ComboBox fx:id="campoAtendente" maxWidth="Infinity"
                      promptText="Quem está atendendo"/>

            <HBox spacing="10">
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="Data do evento *" styleClass="rotulo"/>
                    <DatePicker fx:id="campoEvento" maxWidth="Infinity"
                                promptText="dd/mm/aaaa"/>
                </VBox>
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="Devolução *" styleClass="rotulo"/>
                    <DatePicker fx:id="campoDevolucao" maxWidth="Infinity"
                                promptText="dd/mm/aaaa"/>
                </VBox>
            </HBox>

            <Label text="Peças * (marque uma ou mais)" styleClass="rotulo"/>
            <ListView fx:id="listaPecas" VBox.vgrow="ALWAYS"
                      prefHeight="180" styleClass="lista-pecas"/>

            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Total do aluguel:" styleClass="rotulo"/>
                <Label fx:id="rotuloTotal" text="R$ 0,00"
                       styleClass="valor-destaque"/>
            </HBox>

            <Label fx:id="rotuloErro" styleClass="erro" wrapText="true"/>

            <HBox spacing="8">
                <Button fx:id="botaoRegistrar" text="Registrar locação"
                        onAction="#registrar" styleClass="botao-primario"/>
                <Button text="Limpar" onAction="#limpar"
                        styleClass="botao-secundario"/>
            </HBox>
            <Label text="* campos obrigatórios" styleClass="dica"/>
        </VBox>
    </HBox>
</VBox>
