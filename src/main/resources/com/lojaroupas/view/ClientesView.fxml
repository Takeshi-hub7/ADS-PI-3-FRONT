<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
    Tela de clientes: lista com busca (esquerda) e formulário (direita).
    Controller: ClientesController.
    Os campos seguem os dados do cliente descritos pelo back-end:
    nome, CPF, RG, data de nascimento e medidas.
-->
<VBox xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.lojaroupas.controller.ClientesController"
      spacing="16" styleClass="tela">

    <Label text="Clientes" styleClass="titulo"/>
    <Label text="Cadastro e consulta de clientes" styleClass="subtitulo"/>

    <HBox spacing="20" VBox.vgrow="ALWAYS">

        <!-- Lista de clientes com campo de busca -->
        <VBox styleClass="cartao" spacing="10" HBox.hgrow="ALWAYS">
            <TextField fx:id="campoBusca"
                       promptText="Buscar por nome, CPF ou RG..."/>
            <TableView fx:id="tabelaClientes" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colunaNome" text="Nome"/>
                    <TableColumn fx:id="colunaCpf" text="CPF"/>
                    <TableColumn fx:id="colunaRg" text="RG"/>
                    <TableColumn fx:id="colunaNascimento"
                                 text="Nascimento"/>
                </columns>
            </TableView>
        </VBox>

        <!-- Formulário de cadastro e edição -->
        <VBox styleClass="cartao" spacing="8"
              prefWidth="320" minWidth="320">
            <Label fx:id="rotuloTituloFormulario" text="Novo cliente"
                   styleClass="secao"/>

            <Label text="Nome completo" styleClass="rotulo"/>
            <TextField fx:id="campoNome"/>

            <Label text="CPF" styleClass="rotulo"/>
            <TextField fx:id="campoCpf" promptText="000.000.000-00"/>

            <Label text="RG (opcional)" styleClass="rotulo"/>
            <TextField fx:id="campoRg"/>

            <Label text="Data de nascimento (opcional)"
                   styleClass="rotulo"/>
            <DatePicker fx:id="campoNascimento" maxWidth="Infinity"
                        promptText="dd/mm/aaaa"/>

            <Label text="Medidas (opcional)" styleClass="rotulo"/>
            <TextArea fx:id="campoMedidas" prefRowCount="3"
                      wrapText="true"/>

            <Label fx:id="rotuloErro" styleClass="erro" wrapText="true"/>

            <HBox spacing="8">
                <Button fx:id="botaoSalvar" text="Salvar"
                        onAction="#salvar" styleClass="botao-primario"/>
                <Button text="Limpar" onAction="#novo"
                        styleClass="botao-secundario"/>
                <Button fx:id="botaoExcluir" text="Excluir"
                        onAction="#excluir" styleClass="botao-perigo"/>
            </HBox>
        </VBox>
    </HBox>
</VBox>