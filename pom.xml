<?xml version="1.0" encoding="UTF-8"?>
<!--
    Projeto Maven do front-end desktop (JavaFX) da loja de roupas.
    O front não acessa o banco de dados: toda comunicação é feita
    com a API do back-end, por HTTP.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Identificação do artefato -->
    <groupId>com.lojaroupas</groupId>
    <artifactId>loja-roupas-front</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>loja-roupas-front</name>
    <description>Interface desktop da loja de roupas</description>

    <!-- Versões centralizadas em um único lugar -->
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <java.version>26</java.version>
        <javafx.version>26</javafx.version>
    </properties>

    <dependencies>
        <!-- Componentes visuais (botões, tabelas, formulários) -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- Carregamento das telas descritas em arquivos FXML -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Compila o código com a versão do Java definida acima -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
                <configuration>
                    <release>${java.version}</release>
                </configuration>
            </plugin>

            <!-- Permite executar a aplicação com: mvn javafx:run -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>com.lojaroupas.Main</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>